# Safe default: credential-free synthetic dashboard at http://127.0.0.1:8080
DEMO_MODE=true
API_HOST=127.0.0.1
API_PORT=8080
BOT_DATA_DIR=./data
LOG_LEVEL=INFO

# Read-only/paper bot: set DEMO_MODE=false. Keep live trading disabled.
HL_NETWORK=testnet
HL_ENABLE_LIVE_TRADING=false
PAUSE_NEW_ENTRIES=true
GUARDIAN_ENABLE_LIVE_ACTIONS=false
DAILY_REVIEW_ENABLED=false
TELEGRAM_NOTIFY=false

# Required only for authenticated operational endpoints.
OPERATIONAL_API_TOKEN=

# Live execution credentials. Never commit populated values.
HYPERLIQUID_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=

# Optional DEX/research settings.
DEX_NETWORK=arbitrum
DEX_ENABLE_LIVE_TRADING=false
WALLET_PRIVATE_KEY=
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
FRED_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
